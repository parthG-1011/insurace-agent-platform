# Postgres connection string (Neon pooled URL in production; local Postgres for dev)
DATABASE_URL=postgres://localhost:5432/agentdesk
# 32+ random characters used to sign session cookies: `openssl rand -base64 32`
AUTH_SECRET=
# Public base URL of the app (used in PDF/payment links shared on WhatsApp)
APP_URL=http://localhost:3000
# Razorpay (TEST mode keys from Dashboard → Account & Settings → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when creating the webhook (event: payment_link.paid)
RAZORPAY_WEBHOOK_SECRET=
# Resend API key and sender
RESEND_API_KEY=
EMAIL_FROM="AgentDesk <onboarding@resend.dev>"
